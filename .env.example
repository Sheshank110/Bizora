# ──────────────────────────────────────────────
# Bizora Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# ─── Server Configuration ───
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5001

# ─── Database ───
MONGODB_URI=mongodb://localhost:27017/bizora

# ─── Authentication Secrets ───
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email Provider (Optional: smtp, resend, sendgrid, console) ───
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@bizora.demo
EMAIL_API_KEY=your_email_api_key_or_smtp_secret

# ─── File Storage (Optional: local, cloudinary, s3) ───
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_KEY=your_cloudinary_or_aws_key
FILE_STORAGE_SECRET=your_cloudinary_or_aws_secret
FILE_STORAGE_BUCKET=bizora-documents

# ─── Payments & Webhooks (Stripe / Razorpay Sandbox) ───
PAYMENT_PROVIDER=stripe
PAYMENT_PUBLIC_KEY=pk_test_sample_stripe_public_key
PAYMENT_SECRET=sk_test_sample_stripe_secret_key
PAYMENT_WEBHOOK_SECRET=whsec_sample_webhook_signing_secret

# ─── Client (Vite Environment) ───
VITE_API_URL=http://localhost:5001/api
VITE_SOCKET_URL=http://localhost:5001
